query getPOSAccounts {
  fn: import { getPOSAccounts } from "@src/queries/pos.js",
  entities: [POSAccount, Store]
}

job scheduledScrape {
  executor: PgBoss,
  perform: {
    fn: import { scrapePOS } from "@src/server/scraper.js"
  },
  schedule: {
    cron: "0 2 * * *" // Run at 2 AM daily
  },
  entities: [InventorySnapshot, ProductCatalog, StockLevel, POSAccount, Store]
}

job backfillWeeklySummariesJob {
  executor: PgBoss,
  perform: {
    fn: import { backfillWeeklySummaries } from "@src/actions/weeklySummary.js"
  },
  schedule: {
    cron: "0 3 * * *" // Run at 3 AM daily
  },
  entities: [Store, ProductCatalog, InventoryMovement, WeeklySalesSummary, WeeklyCategorySummary, WeeklyBrandSummary]
}

