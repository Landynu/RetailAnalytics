}

action syncProductCategoriesToDefinitions {
  fn: import { syncProductCategoriesToDefinitions } from "@src/actions.js",
  entities: [ProductCatalog, CategoryDefinition, CategorySubcategory]
}

action syncProductClassifications {
  fn: import { syncProductClassifications } from "@src/actions.js",
  entities: [ProductCatalog, Classification]
}

action syncAllProductEnrichments {
  fn: import { syncAllProductEnrichments } from "@src/actions.js",
  entities: [ProductCatalog, Classification, CategoryDefinition, CategorySubcategory]
}

action configureS3CORS {
  fn: import { configureS3CORS } from "@src/actions.js"
}

action migrateProductImages {
  fn: import { migrateProductImages } from "@src/actions.js",
  entities: [ProductCatalog]
}

route DashboardRoute { path: "/", to: DashboardPage }
page DashboardPage {
  component: import DashboardPage from "@src/pages/Dashboard.jsx",
  authRequired: true
}

route InventoryUploadRoute { path: "/store/:storeId/upload", to: InventoryUploadPage }
page InventoryUploadPage {
  component: import InventoryUploadPage from "@src/pages/InventoryUpload.jsx",
  authRequired: true
}

route SalesTrendsRoute { path: "/store/:storeId/trends", to: SalesTrendsPage }
page SalesTrendsPage {
  component: import SalesTrendsPage from "@src/pages/SalesTrends.jsx",
  authRequired: true
}

route SmartMenuRoute { path: "/store/:storeId/menu", to: SmartMenuPage }
page SmartMenuPage {
  component: import SmartMenuPage from "@src/pages/SmartMenu.jsx",
  authRequired: true
}

route GlobalUploadRoute { path: "/upload", to: GlobalUploadPage }
page GlobalUploadPage {
  component: import GlobalUploadPage from "@src/pages/GlobalUpload.jsx",
  authRequired: true
}

route OrderingRoute { path: "/ordering", to: OrderingPage }
page OrderingPage {
  component: import OrderingDashboard from "@src/pages/OrderingDashboard.jsx",
  authRequired: true
}

route BrandMappingRoute { path: "/brand-mapping", to: BrandMappingPage }
page BrandMappingPage {
  component: import BrandMapping from "@src/pages/BrandMapping.jsx",
  authRequired: true
}

route StoresRoute { path: "/stores", to: StoresPage }
page StoresPage {
  component: import Stores from "@src/pages/Stores.jsx",
  authRequired: true
}

route CategoryManagementRoute { path: "/categories", to: CategoryManagementPage }
page CategoryManagementPage {
  component: import CategoryManagement from "@src/pages/CategoryManagement.jsx",
  authRequired: true
}

route ProductCatalogRoute { path: "/product-catalog", to: ProductCatalogPage }
page ProductCatalogPage {
  component: import ProductCatalog from "@src/pages/ProductCatalog.jsx",
  authRequired: true
}
