app RetailAnalytics {
  wasp: {
    version: "^0.18.1"
  },
  title: "RetailAnalytics",
  head: [
    "<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\" />"
  ],
  client: {
    rootComponent: import { Layout } from "@src/Layout.jsx"
  },
  server: {
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/serverSetup.js"
  },
  auth: {
    userEntity: User,
    methods: {
      usernameAndPassword: {}
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/"
  }
}

route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/pages/auth/Login.jsx"
}
route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import Signup from "@src/pages/auth/Signup.jsx"
}

action uploadInventory {
  fn: import { uploadInventory } from "@src/actions.js",
  entities: [Store, Inventory, Product]
}

action analyzeInventoryExport {
  fn: import { analyzeInventoryExport } from "@src/actions.js",
  entities: [Store, ProductCatalog, Category, InventorySnapshot, StockLevel]
}

action uploadInventoryExport {
  fn: import { uploadInventoryExport } from "@src/actions.js",
  entities: [Store, ProductCatalog, Category, InventorySnapshot, StockLevel]
}

action uploadInventoryLogs {
  fn: import { uploadInventoryLogs } from "@src/actions.js",
  entities: [Store, ProductCatalog, InventoryMovement, StockLevel, InventorySnapshot, UnmatchedRecord]
}

action uploadProductCatalog {
  fn: import { uploadProductCatalog } from "@src/actions.js",
  entities: [ProductCatalog]
}

action createStore {
  fn: import { createStore } from "@src/actions.js",
  entities: [Store]
}

action updateStoreBranding {
  fn: import { updateStoreBranding } from "@src/actions.js",
  entities: [Store]
}

action generateSmartMenu {
  fn: import { generateSmartMenu } from "@src/actions.js",
  entities: [Store, Inventory, Product]
}

action generatePrintableMenu {
  fn: import { generatePrintableMenu } from "@src/actions.js",
  entities: [Store, ProductCatalog, StockLevel]
}

action exportAnalyticsData {
  fn: import { exportAnalyticsData } from "@src/actions.js",
  entities: [Store, ProductCatalog, StockLevel, InventoryMovement]
}

action toggleStoreActive {
  fn: import { toggleStoreActive } from "@src/actions.js",
  entities: [Store]
}

action toggleStoreFavourite {
  fn: import { toggleStoreFavourite } from "@src/actions.js",
  entities: [Store]
}

query getSalesTrends {
  fn: import { getSalesTrends } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, InventorySnapshot]
}

query getUserStores {
  fn: import { getUserStores } from "@src/queries.js",
  entities: [Store]
}

query getStoreById {
  fn: import { getStoreById } from "@src/queries.js",
  entities: [Store]
}

query getInventoryDashboard {
  fn: import { getInventoryDashboard } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, Category]
}

query getTopProductsByCategory {
  fn: import { getTopProductsByCategory } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, Category]
}

query getInventoryMovements {
  fn: import { getInventoryMovements } from "@src/queries.js",
  entities: [Store, ProductCatalog, InventoryMovement]
}

query getCategoryBreakdown {
  fn: import { getCategoryBreakdown } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, Category]
}

query getMenuData {
  fn: import { getMenuData } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, Category]
}

query getStoreAnalytics {
  fn: import { getStoreAnalytics } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, InventoryMovement]
}

query getGlobalAnalytics {
  fn: import { getGlobalAnalytics } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel]
}

query getGlobalAnalyticsFiltered {
  fn: import { getGlobalAnalyticsFiltered } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, InventoryMovement]
}

query getGlobalSalesAnalytics {
  fn: import { getGlobalSalesAnalytics } from "@src/queries.js",
  entities: [Store, ProductCatalog, WeeklySalesSummary]
}

query getDailySalesAnalytics {
  fn: import { getDailySalesAnalytics } from "@src/queries.js",
  entities: [Store, ProductCatalog, InventoryMovement]
}

query getOrderingAnalytics {
  fn: import { getOrderingAnalytics } from "@src/queries.js",
  entities: [Store, ProductCatalog, StockLevel, InventoryMovement, WeeklySalesSummary, Brand, Distributor, BrandDistributor]
}

query getOrCreateOrderWorksheet {
  fn: import { getOrCreateOrderWorksheet } from "@src/actions.js",
  entities: [OrderWorksheet, OrderWorksheetItem, ProductCatalog]
}

action addToOrderWorksheet {
  fn: import { addToOrderWorksheet } from "@src/actions.js",
  entities: [OrderWorksheet, OrderWorksheetItem, ProductCatalog]
}

action updateOrderWorksheetItem {
  fn: import { updateOrderWorksheetItem } from "@src/actions.js",
  entities: [OrderWorksheet, OrderWorksheetItem, ProductCatalog]
}

action removeFromOrderWorksheet {
  fn: import { removeFromOrderWorksheet } from "@src/actions.js",
  entities: [OrderWorksheet, OrderWorksheetItem]
}

action clearOrderWorksheet {
  fn: import { clearOrderWorksheet } from "@src/actions.js",
  entities: [OrderWorksheet, OrderWorksheetItem]
}

action exportOrderWorksheet {
  fn: import { exportOrderWorksheet } from "@src/actions.js",
  entities: [OrderWorksheet, OrderWorksheetItem, ProductCatalog]
}

action markProductStatus {
  fn: import { markProductStatus } from "@src/actions.js",
  entities: [ProductCatalog]
}

action enrichProductFormats {
  fn: import { enrichProductFormats } from "@src/actions.js",
  entities: [ProductCatalog]
}

action backfillWeeklySummaries {
  fn: import { backfillWeeklySummaries } from "@src/actions.js",
  entities: [Store, ProductCatalog, InventoryMovement, WeeklySalesSummary, WeeklyCategorySummary, WeeklyBrandSummary]
}

query getBrandDistributors {
  fn: import { getBrandDistributors } from "@src/queries.js",
  entities: [Brand, Distributor, BrandDistributor]
}

query getDistributors {
  fn: import { getDistributors } from "@src/queries.js",
  entities: [Distributor]
}

action updateBrandDistributors {
  fn: import { updateBrandDistributors } from "@src/actions.js",
  entities: [Brand, BrandDistributor, Distributor]
}

action createDistributor {
  fn: import { createDistributor } from "@src/actions.js",
  entities: [Distributor]
}

action deleteDistributor {
  fn: import { deleteDistributor } from "@src/actions.js",
  entities: [Distributor, BrandDistributor]
}

action syncBrands {
  fn: import { syncBrands } from "@src/actions.js",
  entities: [Brand, ProductCatalog]
}

action seedDistributors {
  fn: import { seedDistributors } from "@src/actions.js",
  entities: [Distributor]
}

route DashboardRoute { path: "/", to: DashboardPage }
page DashboardPage {
  component: import DashboardPage from "@src/pages/Dashboard.jsx",
  authRequired: true
}

route InventoryUploadRoute { path: "/store/:storeId/upload", to: InventoryUploadPage }
page InventoryUploadPage {
  component: import InventoryUploadPage from "@src/pages/InventoryUpload.jsx",
  authRequired: true
}

route SalesTrendsRoute { path: "/store/:storeId/trends", to: SalesTrendsPage }
page SalesTrendsPage {
  component: import SalesTrendsPage from "@src/pages/SalesTrends.jsx",
  authRequired: true
}

route SmartMenuRoute { path: "/store/:storeId/menu", to: SmartMenuPage }
page SmartMenuPage {
  component: import SmartMenuPage from "@src/pages/SmartMenu.jsx",
  authRequired: true
}

route GlobalUploadRoute { path: "/upload", to: GlobalUploadPage }
page GlobalUploadPage {
  component: import GlobalUploadPage from "@src/pages/GlobalUpload.jsx",
  authRequired: true
}

route OrderingRoute { path: "/ordering", to: OrderingPage }
page OrderingPage {
  component: import OrderingDashboard from "@src/pages/OrderingDashboard.jsx",
  authRequired: true
}
