action scrapePOS {
  fn: import { scrapePOS } from "@src/server/scraper.js",
  entities: [InventorySnapshot, ProductCatalog, StockLevel, POSAccount, Store]
}

action createPOSAccount {
  fn: import { createPOSAccount } from "@src/actions/pos.js",
