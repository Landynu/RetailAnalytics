datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
  // Production-ready connection pool configuration
  relationMode = "prisma"
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
  // Optimize for production performance
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
    id               Int     @id @default(autoincrement())
    role             String  @default("ANALYST") // ADMIN, ANALYST
    permissions      String? // JSON string for granular permissions
    stores           Store[]
    unmatchedRecords UnmatchedRecord[]
    orderWorksheets  OrderWorksheet[]
}

model Brand {
    id            Int                 @id @default(autoincrement())
    name          String              @unique
    distributors  BrandDistributor[]
    createdAt     DateTime            @default(now())
    updatedAt     DateTime            @updatedAt
    
    @@index([name])
}

model Distributor {
    id        Int                 @id @default(autoincrement())
    name      String              @unique
    isActive  Boolean             @default(true)
    sortOrder Int                 @default(0)
    brands    BrandDistributor[]
    products  ProductCatalog[]
    createdAt DateTime            @default(now())
}

model BrandDistributor {
    id            Int         @id @default(autoincrement())
    brandId       Int
    brand         Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
    distributorId Int
    distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
    isPrimary     Boolean     @default(false)
    createdAt     DateTime    @default(now())
    
    @@unique([brandId, distributorId])
    @@index([brandId])
    @@index([distributorId])
}

model Store {
    id            Int     @id @default(autoincrement())
    name          String
    location      String
    reportName    String? // Name as it appears in CSV reports
    friendlyName  String? // User-defined display name
    logoUrl       String?
    primaryColor  String? @default("#10b981") // emerald-500
    secondaryColor String? @default("#059669") // emerald-600
    theme         String  @default("LIGHT") // LIGHT, DARK
    fontFamily    String?
    isActive      Boolean @default(true) // Disabled stores excluded from analytics
    isFavourite   Boolean @default(false) // Default filter selection
    isPrimary     Boolean @default(false) // Primary store for ordering analytics
    user          User    @relation(fields: [userId], references: [id])
    userId        Int
    snapshots     InventorySnapshot[]
    stockLevels   StockLevel[]
    movements     InventoryMovement[]
    inventories Inventory[] // Legacy relation
    
    @@index([userId, isActive])
}

model ProductCatalog {
    id             Int      @id @default(autoincrement())
    gtin           String   @unique
    name           String
    brand          String?
    category       String?
    parentCategory String?  // Split from category (e.g., "Edibles")
    subcategory    String?  // Split from category (e.g., "Chocolate")
    strainType     String?  // Sativa, Hybrid, Indica, or N/A
    format         String?  // Extracted from product name (e.g., "1g", "100mg")
    unitCount      Int?     @default(1) // Number of units in pack (1 for singles, 10 for "10 x 0.5g")
    unitSize       String?  // Size of each unit ("3.5g" or "0.5g" from "10 x 0.5g")
    size           String?
    weight         Float?
    thc            Float?
    cbd            Float?
    cannabinoidProfile Json? // Flexible tracking of other cannabinoids and terpenes
    retailPrice    Float?   // From CSV Retail price column
    wholesaleCost  Float?   // From CSV Wholesale cost column
    margin         Float?   // Calculated: (retail - wholesale) / retail
    description    String?
    imageUrl       String?
    lastSeen       DateTime @default(now())
    status         String?  @default("ACTIVE") // ACTIVE, ON_SALE, DISCONTINUED, SEASONAL
    salePrice      Float?   // Promotional pricing when on sale
    caseSize       Int?     @default(12) // Units per case for ordering
    reorderPoint   Int?     // Custom reorder threshold
    orderingNotes  String?  // Notes for purchasing decisions
    distributorId  Int?     // Optional direct product-distributor link
    distributor    Distributor? @relation(fields: [distributorId], references: [id])
    classificationId Int?   // Reference to Classification model
    classification Classification? @relation(fields: [classificationId], references: [id])
    categoryDefinitionId Int? // Reference to CategoryDefinition
    categoryDefinition CategoryDefinition? @relation(fields: [categoryDefinitionId], references: [id])
    subcategoryId  Int?     // Reference to CategorySubcategory
    subcategoryDef CategorySubcategory? @relation(fields: [subcategoryId], references: [id])
    enrichments    ProductEnrichment[]
    stockLevels    StockLevel[]
    movements      InventoryMovement[]
    worksheetItems OrderWorksheetItem[]
    seasonality    ProductSeasonality?
    
    @@index([parentCategory])
    @@index([brand])
    @@index([status])
    @@index([parentCategory, brand])
    @@index([parentCategory, brand, unitCount, unitSize])
    @@index([parentCategory, subcategory])
    @@index([brand, parentCategory])
    @@index([classificationId])
    @@index([categoryDefinitionId])
    @@index([subcategoryId])
}

model Category {
    id           Int        @id @default(autoincrement())
    name         String
    parentId   Int?
    parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
    children     Category[] @relation("CategoryHierarchy")
    hierarchy    String     // e.g., "Edibles > Chocolate > Dark"
    displayOrder Int        @default(0)
}

model InventorySnapshot {
    id          Int      @id @default(autoincrement())
    storeId     Int
    store       Store    @relation(fields: [storeId], references: [id])
    snapshotDate DateTime @default(now())
    fileType    String   // EXPORT, LOG
    rawData     String
    uploadedAt  DateTime @default(now())
    stockLevels StockLevel[]
}

model StockLevel {
    id         Int             @id @default(autoincrement())
    storeId    Int
    store      Store           @relation(fields: [storeId], references: [id])
    productId  Int
    product    ProductCatalog  @relation(fields: [productId], references: [id])
    quantity   Int             @default(0)
    lastUpdated DateTime        @default(now())
    snapshotId Int?
    snapshot   InventorySnapshot? @relation(fields: [snapshotId], references: [id])
    
    @@unique([storeId, productId])
    @@index([storeId, quantity])
    @@index([productId])
}

model InventoryMovement {
    id          Int            @id @default(autoincrement())
    storeId     Int
    store       Store          @relation(fields: [storeId], references: [id])
    productId   Int
    product     ProductCatalog @relation(fields: [productId], references: [id])
    date        DateTime
    type        String         // sale, restock, adjustment, etc.
    employee    String?
    openingQty  Int
    changeQty   Int
    closingQty  Int
    notes       String?
    
    @@index([date, type])
    @@index([storeId, date])
    @@index([productId, date])
    @@index([storeId, type, date])
    @@index([productId, storeId, type, date])
    @@index([storeId, productId, type, date])
    @@index([productId, type, date])
}

model UnmatchedRecord {
    id              Int      @id @default(autoincrement())
    userId          Int
    user            User     @relation(fields: [userId], references: [id])
    recordType      String   // LOG, EXPORT, CATALOG
    productName     String?
    barcode         String?
    sku             String?
    location        String?
    brand           String?
    category        String?
    retailPrice     Float?
    wholesaleCost   Float?
    quantity        Int?
    date            DateTime?
    changeQty       Int?
    employee        String?
    reason          String   // Why it was skipped
    rawData         String   // Full JSON of the original row
    createdAt       DateTime @default(now())
    resolved        Boolean  @default(false)
    resolvedAt      DateTime?
    notes           String?
}

model OrderWorksheet {
    id         Int      @id @default(autoincrement())
    userId     Int
    user       User     @relation(fields: [userId], references: [id])
    name       String   @default("Current Order")
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    items      OrderWorksheetItem[]
}

model OrderWorksheetItem {
    id            Int      @id @default(autoincrement())
    worksheetId   Int
    worksheet     OrderWorksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
    productId     Int
    product       ProductCatalog @relation(fields: [productId], references: [id])
    quantity      Int      // Suggested quantity
    userQuantity  Int?     // User-modified quantity
    notes         String?
    addedAt       DateTime @default(now())
    
    @@unique([worksheetId, productId])
}

// Legacy models for backward compatibility
model Inventory {
    id       Int       @id @default(autoincrement())
    csvData  String
    store    Store     @relation(fields: [storeId], references: [id])
    storeId  Int
    products Product[]
}

model Product {
    id          Int       @id @default(autoincrement())
    name        String
    gtin        String
    price       Float
    inventory   Inventory @relation(fields: [inventoryId], references: [id])
    inventoryId Int
}

// Weekly Summary Tables for Performance Optimization
// These store pre-aggregated data to reduce query load

model WeeklySalesSummary {
  id          Int      @id @default(autoincrement())
  weekStart   DateTime // Monday of the week
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  productId   Int
  product     ProductCatalog @relation(fields: [productId], references: [id])
  
  // Sales metrics
  grossSales  Float    @default(0)
  refunds     Float    @default(0)
  netRevenue  Float    @default(0)
  unitsSold   Int      @default(0)
  refundUnits Int      @default(0)
  
  // Temporal breakdown - day of week (JSON: {"0": sales_amount, "1": sales_amount, ...})
  salesByDayOfWeek Json?
  
  // Time of day breakdown (4 buckets)
  salesMorning   Float @default(0)  // 6am-12pm
  salesAfternoon Float @default(0)  // 12pm-6pm
  salesEvening   Float @default(0)  // 6pm-10pm
  salesNight     Float @default(0)  // 10pm-6am
  
  unitsMorning   Int @default(0)
  unitsAfternoon Int @default(0)
  unitsEvening   Int @default(0)
  unitsNight     Int @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([weekStart, storeId, productId])
  @@index([weekStart, storeId])
  @@index([weekStart, productId])
  @@index([productId, storeId, weekStart])
  @@index([storeId, weekStart, productId])
}

model WeeklyCategorySummary {
  id          Int      @id @default(autoincrement())
  weekStart   DateTime
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  category    String   // parentCategory
  
  grossSales  Float    @default(0)
  refunds     Float    @default(0)
  netRevenue  Float    @default(0)
  unitsSold   Int      @default(0)
  productCount Int     @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([weekStart, storeId, category])
  @@index([weekStart, category])
}

model WeeklyBrandSummary {
  id          Int      @id @default(autoincrement())
  weekStart   DateTime
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  brand       String
  
  grossSales  Float    @default(0)
  refunds     Float    @default(0)
  netRevenue  Float    @default(0)
  unitsSold   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([weekStart, storeId, brand])
  @@index([weekStart, brand])
}

model ProductSeasonality {
  id            Int      @id @default(autoincrement())
  productId     Int      @unique
  product       ProductCatalog @relation(fields: [productId], references: [id])
  
  // Year-over-year metrics
  yoyGrowth     Float?   // % change vs last year same period
  
  // Best performing months (top 3)
  peakMonth1    Int?     // 1-12
  peakMonth2    Int?
  peakMonth3    Int?
  
  // Trend classification
  trend         String   // "GROWING", "DECLINING", "STABLE", "NEW", "SEASONAL"
  
  // Seasonality score (0-100, higher = more seasonal)
  seasonalityScore Float @default(0)
  
  // Last N weeks performance
  last4WeeksAvg   Float @default(0)
  last12WeeksAvg  Float @default(0)
  last52WeeksAvg  Float @default(0)
  
  lastCalculated DateTime @updatedAt
  
  @@index([trend])
  @@index([seasonalityScore])
}

model Classification {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Sativa, Hybrid, Indica, Blend, CBD
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  products    ProductCatalog[]
}

model CategoryDefinition {
  id          Int      @id @default(autoincrement())
  name        String   // e.g., "Flower", "Edibles"
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  subcategories CategorySubcategory[]
  products    ProductCatalog[]
}

model CategorySubcategory {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    CategoryDefinition @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Dried Flower", "Gummies"
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  products    ProductCatalog[]
}

model ProductEnrichment {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)
  enrichedBy  Int?     // userId
  field       String   // Which field was enriched
  oldValue    String?
  newValue    String?
  enrichedAt  DateTime @default(now())
}
